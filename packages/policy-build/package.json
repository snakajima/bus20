    "@bus20/analysis": "0.1.0",
    "@bus20/contracts": "0.1.0",
    "@bus20/datasets": "0.1.0",
    "@bus20/models": "0.1.0",
    "@bus20/policy-runtime": "0.1.0",
    "@bus20/runner": "0.1.0",
    "@bus20/simulator": "0.1.0",
    "zod": "^4.0.0"
  }
}
