{
  "name": "@bus20/runner",
  "version": "0.1.0",
  "private": true,
  "description": "Offline CLI that runs, scores, and replays Bus 2.0 benchmark scenarios",
  "type": "module",
  "bin": {
    "bus20-run": "./dist/src/cli.js"
  },
  "exports": {
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bus20/contracts": "0.1.0",
    "@bus20/graph": "0.1.0",
    "@bus20/scoring": "0.1.0",
    "@bus20/simulator": "0.1.0",
    "zod": "^4.0.0",
    "@bus20/baselines": "0.1.0",
    "@bus20/models": "0.1.0",
    "@bus20/datasets": "0.1.0",
    "@bus20/analysis": "0.1.0",
    "@bus20/policy-runtime": "0.1.0"
  }
}
