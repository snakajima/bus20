{
  "name": "@bus20/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Bus 2.0 benchmark protocol contracts: schemas, types, and JSON boundary validation",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
