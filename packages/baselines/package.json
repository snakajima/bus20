{
  "name": "@bus20/baselines",
  "version": "0.1.0",
  "private": true,
  "description": "Adapters that connect reference dispatchers (the headless Swift CLI) to the Bus 2.0 policy contract",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bus20/contracts": "0.1.0",
    "@bus20/simulator": "0.1.0",
    "zod": "^4.0.0",
    "@bus20/transport": "0.1.0"
  }
}
